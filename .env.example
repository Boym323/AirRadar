# Empty means automatic MockReadsbProvider demo mode. For production, use the
# base URL of the readsb/tar1090 web root; the app appends /data/aircraft.json.
READSB_BASE_URL=
READSB_POLL_INTERVAL_MS=3000
READSB_MAX_RETRY_INTERVAL_MS=30000
RECEIVER_REFRESH_INTERVAL_MS=300000
HISTORY_SAMPLE_INTERVAL_MS=20000
HISTORY_RETENTION_DAYS=30
FLIGHT_CONTINUITY_GAP_MS=600000
AIRCRAFT_STALE_AFTER_MS=15000
# Optional extended live aircraft coverage using the public ADSB.lol API.
# Network observations stay in RAM and never enter local receiver history,
# receiver statistics, reception records, or local alert notifications.
ADSBLOL_ENABLED=false
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_RADIUS_NM=250
ADSBLOL_POLL_INTERVAL_MS=10000
ADSBLOL_REQUEST_TIMEOUT_MS=4000
ADSBLOL_STALE_AFTER_MS=30000
ADSBLOL_MAX_RETRY_INTERVAL_MS=60000
ADSBLOL_MAX_AIRCRAFT=3000
RECEIVER_LAT=
RECEIVER_LON=
RECEIVER_NAME=AirRadar receiver
# Public receiver coordinates: exact | approximate | hidden.
# Approximate is the safe production default; server-side calculations stay exact.
PUBLIC_RECEIVER_POSITION_MODE=approximate
# Empty keeps the demo fully in-memory. Set a real PostgreSQL URL in production.
DATABASE_URL=
NEXT_PUBLIC_APP_NAME=AirRadar
APP_TIMEZONE=Europe/Prague

# Optional aircraft photos from the public Planespotters.net API.
# Keep false unless Planespotters API use is explicitly enabled for production.
AIRCRAFT_PHOTOS_ENABLED=false

# Sample ATC polygons/frequencies are enabled automatically only in demo mode.
# Set false in production; imported PostgreSQL ATC data will then be used.
ATC_SAMPLE_ENABLED=

# Optional enrichment. ADSBDB is a free community API and needs no API key.
# Keep false for a completely offline/demo install.
ADSBDB_ENABLED=false
ADSBDB_BASE_URL=https://api.adsbdb.com/v0
# Daily aircraft metadata source. Stored in PostgreSQL and mirrored in RAM.
AIRCRAFT_METADATA_URL=https://raw.githubusercontent.com/wiedehopf/tar1090-db/refs/heads/csv/aircraft.csv.gz

# Optional commercial flight-plan enrichment. Never exposed to the browser.
FLIGHTAWARE_API_KEY=

# Server-side alerts. Local development uses data/alerts.json; production uses
# the systemd-managed /var/lib/airradar/alerts.json state file.
ALERT_COOLDOWN_MS=7200000
ALERT_EMERGENCY_ENABLED=false
# Required to enable server-side watchlist rule mutations. Never expose this
# token through NEXT_PUBLIC_* variables or client bundles.
WATCHLIST_ADMIN_TOKEN=
PUSHOVER_ENABLED=false
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
