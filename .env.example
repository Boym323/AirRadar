# Empty means automatic MockReadsbProvider demo mode. For production, use the
# base URL of the readsb/tar1090 web root; the app appends /data/aircraft.json.
READSB_BASE_URL=
# Interval between local readsb polls, in milliseconds.
READSB_POLL_INTERVAL_MS=3000
# Maximum backoff between retries after a local readsb polling failure, in milliseconds.
READSB_MAX_RETRY_INTERVAL_MS=30000
# Interval for refreshing receiver metadata from readsb, in milliseconds.
RECEIVER_REFRESH_INTERVAL_MS=300000
# Minimum interval between persisted aircraft-history samples, in milliseconds.
HISTORY_SAMPLE_INTERVAL_MS=20000
# Number of days to keep persisted aircraft history.
HISTORY_RETENTION_DAYS=30
# Maximum gap between observations that may still belong to the same flight, in milliseconds.
FLIGHT_CONTINUITY_GAP_MS=600000
# Remove a local aircraft from the live state after this observation age, in milliseconds.
AIRCRAFT_STALE_AFTER_MS=15000
# Optional extended live aircraft coverage using the public ADSB.lol API.
# Network observations stay in RAM and never enter local receiver history,
# receiver statistics, reception records, or local alert notifications.
# Set true only alongside a configured real readsb receiver.
ADSBLOL_ENABLED=false
# ADSB.lol API base URL; the standard public endpoint is shown below.
ADSBLOL_BASE_URL=https://api.adsb.lol
# Geographic query radius around the receiver, in nautical miles (0-250).
ADSBLOL_RADIUS_NM=250
# Interval between ADSB.lol polls, in milliseconds.
ADSBLOL_POLL_INTERVAL_MS=10000
# Maximum time to wait for one ADSB.lol HTTP request, in milliseconds.
ADSBLOL_REQUEST_TIMEOUT_MS=4000
# Age after which the last network snapshot is considered stale, in milliseconds.
ADSBLOL_STALE_AFTER_MS=30000
# Maximum backoff between retries after an ADSB.lol polling failure, in milliseconds.
ADSBLOL_MAX_RETRY_INTERVAL_MS=60000
# Upper bound for the number of network aircraft retained in RAM per snapshot.
ADSBLOL_MAX_AIRCRAFT=3000
# Receiver latitude in decimal degrees; used for distance/bearing calculations and upstream queries.
RECEIVER_LAT=
# Receiver longitude in decimal degrees; used for distance/bearing calculations and upstream queries.
RECEIVER_LON=
# Display name shown for the receiver in the UI and system status.
RECEIVER_NAME=AirRadar receiver
# Public receiver coordinates: exact | approximate | hidden.
# Approximate is the safe production default; server-side calculations stay exact.
PUBLIC_RECEIVER_POSITION_MODE=approximate

# Optional OGN / FLARM APRS-IS live integration. Disabled by default. OGN is
# server-side only, uses the canonical receiver coordinates above, and stays
# outside ADS-B state, history, statistics, alerts, and receiver metrics.
OGN_ENABLED=false
OGN_HOST=aprs.glidernet.org
OGN_PORT=14580
OGN_RADIUS_KM=250
OGN_CONNECT_TIMEOUT_MS=10000
OGN_HANDSHAKE_TIMEOUT_MS=10000
OGN_KEEPALIVE_MS=240000
OGN_STALE_AFTER_MS=15000
OGN_REMOVE_AFTER_MS=60000
OGN_MAX_PACKET_AGE_MS=120000
OGN_RECONNECT_MIN_MS=1000
OGN_RECONNECT_MAX_MS=30000
# Server-side official OGN DDB endpoint. Runtime adds a validated
# device_id=<comma-separated-ids> target and t=1 for rich JSON; only explicit
# representation/server failures may fall back to the same batch with j=1.
# Rate limits and network failures use bounded retry instead.
OGN_DDB_URL=https://ddb.glidernet.org/download/?j=1&t=1
OGN_DDB_REFRESH_MS=21600000
OGN_DDB_MAX_STALE_MS=86400000
# Runtime resolves only active OGN device IDs through bounded targeted batches.
OGN_DDB_BATCH_SIZE=50
OGN_DDB_BATCH_DELAY_MS=1000
OGN_DDB_MIN_REQUEST_INTERVAL_MS=10000
OGN_DDB_NEGATIVE_TTL_MS=1800000
OGN_DDB_CACHE_MAX_ENTRIES=10000
# Persistent last-known-good DDB resolutions. Production defaults to enabled
# because the systemd unit grants /var/lib/airradar via StateDirectory; set
# false for ephemeral installs or development.
OGN_DDB_PERSIST_CACHE=
OGN_DDB_CACHE_FILE=/var/lib/airradar/ogn-ddb-cache-v1.json
# Optional emergency fail-closed whitelist generated from the SoftRF project.
# It never replaces official OGN DDB or its persistent cache and exposes no
# SoftRF metadata. Invalid, absent, or expired entries remain hidden.
OGN_SOFTRF_DDB_ENABLED=false
OGN_SOFTRF_DDB_PATH=/var/lib/airradar/ogn/softrf/ogn.db
# Required sidecar next to the database: ogn.db.meta.json. Its generatedAt
# is the TTL timestamp, and sha256 must bind the metadata to this exact file;
# database mtime is used only to detect replacement.
OGN_SOFTRF_DDB_MAX_AGE_HOURS=168
# Separate operational updater. It runs outside the Next.js process and uses
# the GitHub Actions artifact created by SoftRF's adb.yml workflow.
OGN_SOFTRF_UPDATE_ENABLED=true
OGN_SOFTRF_UPDATE_MAX_AGE_HOURS=168
# GitHub artifact downloads may require a token. Keep it server-side and never log it.
OGN_SOFTRF_GITHUB_TOKEN=
OGN_MAX_TARGETS=5000
# Empty disables PostgreSQL persistence and keeps the demo fully in-memory.
# In production, set a PostgreSQL connection URL, for example postgresql://user:password@host:5432/db.
DATABASE_URL=
# Browser-visible application name.
NEXT_PUBLIC_APP_NAME=AirRadar
# Client-side map overview radius in nautical miles (25–500, default 250).
NEXT_PUBLIC_MAP_RADIUS_NM=250
# IANA time zone used for daily boundaries and date-based statistics.
APP_TIMEZONE=Europe/Prague

# Optional server-side Aviation Weather Center integration. Weather is kept in
# bounded RAM caches only; it is never written to PostgreSQL or aircraft SSE.
# Set true to enable the server-side Aviation Weather Center integration.
AVIATION_WEATHER_ENABLED=false
# Aviation Weather Center API base URL; the official HTTPS host is required.
AVIATION_WEATHER_BASE_URL=https://aviationweather.gov
# Maximum time to wait for one weather API request, in milliseconds.
AVIATION_WEATHER_REQUEST_TIMEOUT_MS=5000
# How long METAR responses remain fresh in the RAM cache, in milliseconds.
AVIATION_WEATHER_METAR_TTL_MS=300000
# How long TAF responses remain fresh in the RAM cache, in milliseconds.
AVIATION_WEATHER_TAF_TTL_MS=600000
# How long SIGMET responses remain fresh in the RAM cache, in milliseconds.
AVIATION_WEATHER_SIGMET_TTL_MS=300000
# How long an older cached weather response may be served after a provider error, in milliseconds.
AVIATION_WEATHER_STALE_IF_ERROR_MS=1800000
# Use a project identifier/contact, never a private IP, token, or secret.
AVIATION_WEATHER_USER_AGENT=

# Optional aircraft photos from the public Planespotters.net API.
# Keep false unless Planespotters API use is explicitly enabled for production.
# Set true to allow server-side photo lookups.
AIRCRAFT_PHOTOS_ENABLED=false

# Sample ATC polygons/frequencies are enabled automatically only in demo mode.
# Set false in production; imported PostgreSQL ATC data will then be used.
# Leave empty for automatic behavior: enabled in demo mode, disabled with a real receiver.
ATC_SAMPLE_ENABLED=

# Optional enrichment. ADSBDB is a free community API and needs no API key.
# Keep false for a completely offline/demo install.
ADSBDB_ENABLED=false
# ADSBDB API base URL used for aircraft metadata and route lookups.
ADSBDB_BASE_URL=https://api.adsbdb.com/v0
# URL of the daily aircraft metadata CSV(.gz) source. Data is stored in PostgreSQL and mirrored in RAM.
AIRCRAFT_METADATA_URL=https://raw.githubusercontent.com/wiedehopf/tar1090-db/refs/heads/csv/aircraft.csv.gz

# Optional commercial flight-plan enrichment. Never exposed to the browser.
# Double opt-in: both this flag and a real API key are required. Placeholder
# values such as EMPTY do not activate the provider. Lookups run only when an
# aircraft detail is explicitly requested and are protected by a local budget.
FLIGHTAWARE_ENABLED=false
FLIGHTAWARE_API_KEY=

# Server-side alerts. Local development uses data/alerts.json; production uses
# the systemd-managed /var/lib/airradar/alerts.json state file.
# Minimum time between repeated alerts for the same aircraft/rule, in milliseconds.
ALERT_COOLDOWN_MS=7200000
# Set true to generate alerts when an aircraft enters an emergency state.
ALERT_EMERGENCY_ENABLED=false
# Required to enable server-side watchlist rule mutations. Never expose this
# token through NEXT_PUBLIC_* variables or client bundles.
WATCHLIST_ADMIN_TOKEN=
# Set true to send server alerts through Pushover; both credentials below are required.
PUSHOVER_ENABLED=false
# Pushover user or group key that receives notifications.
PUSHOVER_USER_KEY=
# Pushover application/API token used to send notifications.
PUSHOVER_API_TOKEN=
