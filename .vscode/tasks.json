{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AirRadar: Start RI V2 agents B-F",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start-ri-v2-agents.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AirRadar: Attach RI V2 agents",
      "type": "shell",
      "command": "tmux attach -t ri-v2",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AirRadar: RI V2 agent status",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/status-ri-v2-agents.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
