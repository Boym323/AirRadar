[Unit]
Description=AirRadar personal ADS-B radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airradar
Group=airradar
WorkingDirectory=/var/www/airradar
EnvironmentFile=/var/www/airradar/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 192.168.1.142 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
