[Unit]
Description=AirRadar personal ADS-B radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airradar
Group=airradar
WorkingDirectory=/var/www/airradar
EnvironmentFile=/var/www/airradar/.env
Environment=NODE_ENV=production
# AirRadar instrumentation owns SIGTERM/SIGINT; do not install Next's
# process.exit-based start-server handler in the same process.
Environment=NEXT_MANUAL_SIG_HANDLE=1
ExecStart=/usr/bin/node /var/www/airradar/scripts/start-production.mjs start --hostname 192.168.1.142 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
