[Unit]
Description=Update AirRadar ATC and terminal procedure data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=airradar
Group=airradar
WorkingDirectory=/var/www/airradar
EnvironmentFile=-/var/www/airradar/.env
ExecStart=/usr/bin/flock -n /var/lib/airradar/aviation-data-sync.lock /usr/bin/node /var/www/airradar/scripts/aviation-data-sync.mjs
StateDirectory=airradar
StateDirectoryMode=0750
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/airradar/data/procedures/generated
StandardOutput=journal
StandardError=journal
