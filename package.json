{
  "name": "airradar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2",
    "deepmerge-ts": "8.0.0",
    "postcss": "8.5.28"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-maplibre-worker.mjs",
    "build": "NODE_ENV=production node scripts/version.mjs write-build-metadata && prisma contract emit && next build",
    "build:prepared": "NODE_ENV=production node scripts/version.mjs write-build-metadata && next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .cache/eslint/",
    "typecheck": "prisma contract emit && next typegen && tsc --noEmit",
    "typecheck:prepared": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "test:targeted": "vitest run",
    "test:full": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:memory": "vitest run tests/aircraft-metadata-catalog.test.ts tests/enrichment-cache.test.ts tests/sse-capacity.test.ts tests/alert-history.test.ts",
    "test:scale": "vitest run --config vitest.scale.config.ts",
    "test:production": "node scripts/production-gates.mjs",
    "test:production:browser": "RUN_BROWSER_GATE=1 node scripts/production-gates.mjs --browser",
    "test:production:all": "RUN_BROWSER_GATE=1 node scripts/production-gates.mjs --all",
    "test:watch": "vitest",
    "icons:sync:tar1090": "node scripts/sync-tar1090-icons.mjs",
    "prisma:generate": "prisma contract emit",
    "prisma:migrate": "prisma migration plan --name init",
    "prisma:deploy": "prisma db migrate",
    "prisma:verify": "prisma db verify",
    "airports:import": "JITI_TSCONFIG_PATHS=true jiti scripts/airports-import.ts",
    "airports:sync": "JITI_TSCONFIG_PATHS=true jiti scripts/airports-sync.ts",
    "atc:import": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-import.ts",
    "atc:sync:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-sync-cz.ts",
    "atc:status:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-status-cz.ts",
    "atc:sync:sk": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-sync-sk.ts",
    "atc:status:sk": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-status-sk.ts",
    "atc:sync:at": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-sync-at.ts",
    "atc:status:at": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-status-at.ts",
    "benchmark:atc": "ATC_BENCHMARK_NON_PRODUCTION=true JITI_TSCONFIG_PATHS=true jiti scripts/benchmark-atc-lookup.ts",
    "ats:sync:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-sync-cz.ts",
    "ats:status:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-status-cz.ts",
    "ats:status:sk": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-status-sk.ts",
    "ats:sync:sk": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-sync-sk.ts",
    "ats:sync:at": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-sync-at.ts",
    "ats:status:at": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-status-at.ts",
    "procedures:sync": "JITI_TSCONFIG_PATHS=true jiti scripts/procedures-sync.ts",
    "aviation-data:sync": "node scripts/aviation-data-sync.mjs",
    "generate:boundary:at": "node scripts/generate-at-boundary.mjs",
    "changelog": "node scripts/changelog.mjs generate",
    "changelog:backfill": "node scripts/changelog.mjs backfill"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "@tanstack/react-query": "^5.103.1",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "geist": "^1.7.2",
    "lru-cache": "^11.5.3",
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.4",
    "p-limit": "^7.3.3",
    "pdfjs-dist": "^5.4.149",
    "pino": "^10.3.1",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shapefile": "^0.6.6",
    "temporal-polyfill": "1.0.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "prisma": "8.0.0-rc.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
