{
  "name": "airradar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2",
    "deepmerge-ts": "8.0.0",
    "postcss": "8.5.28"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production node scripts/version.mjs write-build-metadata && prisma contract emit && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma contract emit && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:targeted": "vitest run",
    "test:full": "vitest run",
    "test:memory": "vitest run tests/aircraft-metadata-catalog.test.ts tests/enrichment-cache.test.ts tests/sse-capacity.test.ts tests/alert-history.test.ts",
    "test:production": "node scripts/production-gates.mjs",
    "test:production:browser": "RUN_BROWSER_GATE=1 node scripts/production-gates.mjs",
    "test:watch": "vitest",
    "icons:sync:tar1090": "node scripts/sync-tar1090-icons.mjs",
    "prisma:generate": "prisma contract emit",
    "prisma:migrate": "prisma migration plan --name init",
    "prisma:deploy": "prisma db migrate",
    "prisma:verify": "prisma db verify",
    "airports:import": "JITI_TSCONFIG_PATHS=true jiti scripts/airports-import.ts",
    "airports:sync": "JITI_TSCONFIG_PATHS=true jiti scripts/airports-sync.ts",
    "atc:import": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-import.ts",
    "atc:sync:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-sync-cz.ts",
    "atc:status:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-status-cz.ts",
    "atc:sync:sk": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-sync-sk.ts",
    "atc:status:sk": "JITI_TSCONFIG_PATHS=true jiti scripts/atc-status-sk.ts",
    "ats:sync:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-sync-cz.ts",
    "ats:status:cz": "JITI_TSCONFIG_PATHS=true jiti scripts/ats-status-cz.ts",
    "changelog": "node scripts/changelog.mjs generate",
    "changelog:backfill": "node scripts/changelog.mjs backfill"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "cheerio": "^1.2.0",
    "geist": "^1.7.2",
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "prisma": "8.0.0-rc.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
