model Aircraft {
  id           Int      @id @default(autoincrement())
  icaoHex      String   @unique
  registration String?
  registrationCountry String?
  registrationCountryCode String?
  aircraftType String?
  manufacturer String?
  model String?
  operator String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  flights      Flight[]
}

model AircraftMetadataCache {
  icaoHex            String   @id
  registration       String?
  icaoTypeCode       String?
  aircraftDescription String?
  operator           String?
  flags              String?
  year               String?
  source             String
  sourceReference    String
  datasetVersion     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@index([source])
  @@index([updatedAt])
}

model AircraftMetadataSync {
  id            String   @id
  sourceUrl     String
  etag          String?
  lastCheckedAt DateTime?
  lastUpdatedAt DateTime?
  recordCount   Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

model ReceiverDailyStats {
  date                        String   @id
  uniqueAircraftCount         Int      @default(0)
  maxConcurrentAircraft       Int      @default(0)
  maxDistanceKm               Float    @default(0)
  maxDistanceIcaoHex          String?
  maxDistanceBearing          Float?
  maxDistanceRegistration     String?
  maxDistanceAt               DateTime?
  receiverMessagesCount       Float?
  receiverMessagesRawLast     Float?
  maxGroundSpeedKt            Float?
  maxGroundSpeedIcaoHex       String?
  maxGroundSpeedRegistration  String?
  maxGroundSpeedCallsign      String?
  maxGroundSpeedAt            DateTime?
  updatedAt                   DateTime @default(now())
  aircraft                    ReceiverDailyAircraft[]
  coverage                    ReceiverDailyCoverage[]
  coverageAltitude            ReceiverDailyCoverageAltitude[]

  @@index([maxDistanceKm])
}

model ReceiverDailyAircraft {
  date         String
  icaoHex      String
  aircraftType String?
  airline      String?
  updatedAt    DateTime @default(now())
  dailyStats   ReceiverDailyStats @relation(fields: [date], references: [date], onDelete: Cascade)

  @@id([date, icaoHex])
}

model ReceiverDailyCoverage {
  date          String
  azimuthBucket Int
  maxDistanceKm Float
  updatedAt     DateTime @default(now())
  dailyStats    ReceiverDailyStats @relation(fields: [date], references: [date], onDelete: Cascade)

  @@id([date, azimuthBucket])
}

model ReceiverDailyCoverageAltitude {
  date          String
  azimuthBucket Int
  altitudeBand  Int
  maxDistanceKm Float
  updatedAt     DateTime @default(now())
  dailyStats    ReceiverDailyStats @relation(fields: [date], references: [date], onDelete: Cascade)

  @@id([date, azimuthBucket, altitudeBand])
}

model ReceiverCoverageHourly {
  hour               DateTime
  dimension          String
  bucketKey          String
  availableCount     Int      @default(0)
  capturedCount      Int      @default(0)
  referenceProviders String
  updatedAt          DateTime @default(now())

  @@id([hour, bucketKey])
  @@index([hour])
  @@index([dimension, hour])
}

model Flight {
  id         Int              @id @default(autoincrement())
  instanceKey String          @unique
  aircraftId Int
  callsign   String?
  registration String?
  aircraftType String?
  airline String?
  origin String?
  destination String?
  maxAltitude Int?
  minDistanceKm Float?
  startTime  DateTime         @default(now())
  lastSeenAt DateTime         @default(now())
  endTime    DateTime?
  aircraft   Aircraft         @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  positions  FlightPosition[]
  intelligenceEvents FlightEvent[]

  @@index([aircraftId, startTime])
  @@index([aircraftId, endTime, lastSeenAt])
  @@index([startTime, origin])
  @@index([startTime, destination])
}

model FlightEvent {
  id              Int      @id @default(autoincrement())
  eventKey        String   @unique
  type            String
  icaoHex         String
  flightId        Int?
  occurredAt      DateTime
  detectedAt      DateTime @default(now())
  latitude        Float?
  longitude       Float?
  altitude        Int?
  confidence      Float
  airportIcao     String?
  runway          String?
  sectorId        String?
  evidenceJson    String
  metadataJson    String?
  aircraft        Aircraft @relation(fields: [icaoHex], references: [icaoHex], onDelete: Cascade)
  flight          Flight?  @relation(fields: [flightId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([icaoHex, occurredAt])
  @@index([flightId, occurredAt])
  @@index([airportIcao, occurredAt])
}

model Airport {
  id                Int      @id @default(autoincrement())
  icao              String   @unique
  iata              String?
  name              String
  city              String?
  country           String?
  latitude          Float
  longitude         Float
  ourAirportsId     Int?     @unique
  ourAirportsIdent  String?  @unique
  type              String?
  elevationFt       Int?
  scheduledService  Boolean?
  region            String?
  localCode         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  runways           AirportRunway[]
  frequencies       AirportFrequency[]
  associatedNavaids Navaid[]

  @@index([iata])
  @@index([country])
  @@index([ourAirportsIdent])
}

model AirportRunway {
  id                     Int      @id
  airportId              Int
  sourceAirportIdent     String
  lengthFt               Int?
  widthFt                Int?
  surface                String?
  lighted                Boolean?
  closed                 Boolean?
  leIdent                String?
  leLatitude             Float?
  leLongitude            Float?
  leElevationFt          Int?
  leHeadingDegT          Float?
  leDisplacedThresholdFt Int?
  heIdent                String?
  heLatitude             Float?
  heLongitude            Float?
  heElevationFt          Int?
  heHeadingDegT          Float?
  heDisplacedThresholdFt Int?
  airport                Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
}

model AirportFrequency {
  id                 Int      @id
  airportId          Int
  sourceAirportIdent String
  type               String
  description        String?
  frequencyMhz       Float
  airport            Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
  @@index([airportId, frequencyMhz])
}

model Navaid {
  id                     Int      @id
  filename               String
  ident                  String
  name                   String
  type                   String
  frequencyKhz           Int?
  latitude               Float
  longitude              Float
  elevationFt            Int?
  country                String?
  dmeFrequencyKhz        Int?
  dmeChannel             String?
  dmeLatitude            Float?
  dmeLongitude           Float?
  dmeElevationFt         Int?
  slavedVariationDeg     Float?
  magneticVariationDeg   Float?
  usageType              String?
  power                  String?
  associatedAirportId    Int?
  associatedAirportIdent String?
  associatedAirport      Airport? @relation(fields: [associatedAirportId], references: [id], onDelete: SetNull)

  @@index([ident])
  @@index([type])
  @@index([country])
  @@index([associatedAirportId])
  @@index([latitude, longitude])
}

model AtcSector {
  id                String @id
  name              String
  polygonJson       String
  lowerAltitudeFt   Int?
  upperAltitudeFt   Int?
  lowerAltitudeReference String?
  upperAltitudeReference String?
  atcCallsign       String?
  service           String?
  airspaceType      String?
  airspaceClass     String?
  remarks           String?
  primaryFrequencyMhz Float?
  alternateFrequenciesJson String?
  country           String?
  source            String
  sourceReference   String
  validFrom         DateTime?
  validTo           DateTime?
  lastVerifiedAt    DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([country])
  @@index([validFrom, validTo])
}

model AtcTransmitter {
  id           String @id
  name         String
  latitude     Float
  longitude    Float
  service      String?
  frequencyMhz Float
  notes        String?
  source       String
  sourceReference String
  validFrom    DateTime?
  validTo      DateTime?
  lastVerifiedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model FlightPosition {
  id           Int      @id @default(autoincrement())
  flightId     Int
  recordedAt   DateTime @default(now())
  lat          Float
  lon          Float
  altitude     Int?
  altitudeSource String?
  altitudeProvider String?
  altitudeProtocol String?
  altitudeType String?
  altitudeObservedAt DateTime?
  altitudeDecisionReason String?
  groundSpeed  Float?
  track        Float?
  verticalRate Int?
  flight       Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId, recordedAt])
  @@index([recordedAt])
}

/// Sparse aircraft-observed weather samples. This is intentionally separate
/// from FlightPosition so ordinary ADS-B position history stays compact.
model AircraftWeatherObservation {
  id                   Int      @id @default(autoincrement())
  dedupKey             String   @unique
  aircraftHex          String
  flightId             Int?
  callsign             String?
  observedAt           DateTime
  receivedAt           DateTime?
  lat                  Float
  lon                  Float
  altitudeFt           Int
  altitudeType         String
  windDirectionDeg     Float?
  windSpeedKt          Float?
  staticAirTempC       Float?
  totalAirTempC        Float?
  staticPressureHpa    Float?
  humidityPct          Float?
  turbulenceLevel      Int?
  source               String
  provider             String?
  quality              String
  weatherSourceQuality String?
  bdsConfidence        String?
  provenanceJson       String
  createdAt            DateTime @default(now())

  @@index([observedAt])
  @@index([aircraftHex, observedAt])
  @@index([lat, lon, observedAt])
  @@index([altitudeFt, observedAt])
}

/// Sparse ADS-B navigation integrity observations. Original fields remain
/// separate; provenanceJson preserves the field-level freshness contract.
model NavigationIntegrityObservation {
  id             Int      @id @default(autoincrement())
  dedupKey       String   @unique
  aircraftHex    String
  flightId       String?
  observedAt     DateTime
  receivedAt     DateTime?
  lat            Float
  lon            Float
  latCell        Int
  lonCell        Int
  altitudeFt     Int?
  altitudeBand   Int
  nic            Int?
  nacP           Int?
  nacV           Int?
  sil            Int?
  sda            Int?
  gva            Int?
  adsbVersion    Int?
  positionSource String
  source         String
  provider       String?
  quality        String
  confidence     String
  provenanceJson String
  createdAt      DateTime @default(now())

  @@index([observedAt], map: "ni_obs_observed_idx")
  @@index([aircraftHex, observedAt], map: "ni_obs_aircraft_observed_idx")
  @@index([latCell, lonCell, observedAt], map: "ni_obs_cell_observed_idx")
  @@index([altitudeBand, observedAt], map: "ni_obs_altitude_observed_idx")
}

model NavigationIntegrityAnomaly {
  id                    String   @id
  startedAt             DateTime
  lastObservedAt        DateTime
  endedAt               DateTime?
  cellKeysJson          String
  altitudeBandsJson     String
  affectedAircraftCount Int
  sampleCount           Int
  baselineAircraftCount Int
  medianNic             Float?
  medianNacP            Float?
  medianNacV            Float?
  baselineMedianNic     Float?
  baselineMedianNacP    Float?
  baselineMedianNacV    Float?
  confidence            String
  severity              String
  evidenceJson          String
  createdAt             DateTime @default(now())

  @@index([startedAt], map: "ni_anomaly_started_idx")
  @@index([lastObservedAt], map: "ni_anomaly_last_idx")
  @@index([endedAt], map: "ni_anomaly_ended_idx")
}

model AltitudeAnomaly {
  id                 Int      @id @default(autoincrement())
  icaoHex            String
  flightId           Int?
  observedAt         DateTime
  detectedAt         DateTime @default(now())
  selectedAltitude   Int?
  selectedSource     String?
  decisionReason     String
  anomalyType        String
  candidatesJson     String

  @@index([observedAt])
  @@index([icaoHex, observedAt])
  @@index([flightId, observedAt])
}

/// Durable Alerts & Fleets V1 configuration and delivery ledger.
model AlertFleet {
  id          String   @id
  name        String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  matchers    AlertFleetMatcher[]
  rules       AlertRule[]
}

model AlertFleetMatcher {
  id        String   @id
  fleetId   String
  type      String
  value     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  fleet     AlertFleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@unique([fleetId, type, value])
  @@index([fleetId, enabled])
}

model AlertGeofence {
  id           String   @id
  name         String
  centerLat    Float
  centerLon    Float
  radiusMeters Float
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  rules        AlertRule[]
}

model AlertRule {
  id             String   @id
  name           String
  enabled        Boolean  @default(true)
  targetKind     String
  fleetId        String?
  trigger        String
  triggerConfig  String
  channelsJson   String
  cooldownMs     Int?
  activatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  fleet          AlertFleet? @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  geofenceId     String?
  geofence       AlertGeofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  occurrences    AlertOccurrence[]

  @@index([enabled])
  @@index([fleetId])
  @@index([geofenceId])
}

model AlertOccurrence {
  id             String   @id
  ruleId         String
  sourceType     String
  sourceKey      String
  trigger        String
  aircraftIcao   String
  registration   String?
  callsign       String?
  flightId       Int?
  flightEventId  Int?
  geofenceId     String?
  occurredAt     DateTime
  payloadJson    String
  createdAt      DateTime @default(now())
  rule           AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deliveries     AlertDelivery[]

  @@unique([ruleId, sourceType, sourceKey])
  @@index([occurredAt])
  @@index([aircraftIcao, occurredAt])
  @@index([trigger, occurredAt])
}

model AlertDelivery {
  id            String   @id
  occurrenceId  String
  channel       String
  status        String   @default("PENDING")
  attemptCount  Int      @default(0)
  nextAttemptAt DateTime
  claimedAt     DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  occurrence    AlertOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, channel])
  @@index([status, nextAttemptAt])
  @@index([claimedAt])
}
