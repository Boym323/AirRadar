model Aircraft {
  id           Int      @id @default(autoincrement())
  icaoHex      String   @unique
  registration String?
  registrationCountry String?
  registrationCountryCode String?
  aircraftType String?
  manufacturer String?
  model String?
  operator String?
  createdAt    DateTime @default(now())
     updatedAt    DateTime @default(now())
  flights      Flight[]
}

model AircraftMetadataCache {
  icaoHex            String   @id
  registration       String?
  icaoTypeCode       String?
  aircraftDescription String?
  operator           String?
  flags              String?
  year               String?
  source             String
  sourceReference    String
  datasetVersion     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@index([source])
  @@index([updatedAt])
}

model AircraftMetadataSync {
  id            String   @id
  sourceUrl     String
  etag          String?
  lastCheckedAt DateTime?
  lastUpdatedAt DateTime?
  recordCount   Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

model Flight {
  id         Int              @id @default(autoincrement())
  instanceKey String          @unique
  aircraftId Int
  callsign   String?
  registration String?
  aircraftType String?
  airline String?
  origin String?
  destination String?
  maxAltitude Int?
  minDistanceKm Float?
  startTime  DateTime         @default(now())
  lastSeenAt DateTime         @default(now())
  endTime    DateTime?
  aircraft   Aircraft         @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  positions  FlightPosition[]

  @@index([aircraftId, startTime])
  @@index([aircraftId, endTime, lastSeenAt])
}

model Airport {
  id        Int    @id @default(autoincrement())
  icao      String @unique
  iata      String?
  name      String
  city      String?
  country   String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([iata])
  @@index([country])
}

model AtcSector {
  id                String @id
  name              String
  polygonJson       String
  lowerAltitudeFt   Int?
  upperAltitudeFt   Int?
  lowerAltitudeReference String?
  upperAltitudeReference String?
  atcCallsign       String?
  service           String?
  primaryFrequencyMhz Float?
  alternateFrequenciesJson String?
  country           String?
  source            String
  sourceReference   String
  validFrom         DateTime?
  validTo           DateTime?
  lastVerifiedAt    DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([country])
  @@index([validFrom, validTo])
}

model AtcTransmitter {
  id           String @id
  name         String
  latitude     Float
  longitude    Float
  service      String?
  frequencyMhz Float
  notes        String?
  source       String
  sourceReference String
  validFrom    DateTime?
  validTo      DateTime?
  lastVerifiedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model FlightPosition {
  id           Int      @id @default(autoincrement())
  flightId     Int
  recordedAt   DateTime @default(now())
  lat          Float
  lon          Float
  altitude     Int?
  groundSpeed  Float?
  track        Float?
  verticalRate Int?
  flight       Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId, recordedAt])
  @@index([recordedAt])
}
