model Aircraft {
  id           Int      @id @default(autoincrement())
  icaoHex      String   @unique
  registration String?
  registrationCountry String?
  registrationCountryCode String?
  aircraftType String?
  manufacturer String?
  model String?
  operator String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  flights      Flight[]
}

model AircraftMetadataCache {
  icaoHex            String   @id
  registration       String?
  icaoTypeCode       String?
  aircraftDescription String?
  operator           String?
  flags              String?
  year               String?
  source             String
  sourceReference    String
  datasetVersion     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@index([source])
  @@index([updatedAt])
}

model AircraftMetadataSync {
  id            String   @id
  sourceUrl     String
  etag          String?
  lastCheckedAt DateTime?
  lastUpdatedAt DateTime?
  recordCount   Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

model ReceiverDailyStats {
  date                        String   @id
  uniqueAircraftCount         Int      @default(0)
  maxConcurrentAircraft       Int      @default(0)
  maxDistanceKm               Float    @default(0)
  maxDistanceIcaoHex          String?
  maxDistanceBearing          Float?
  maxDistanceRegistration     String?
  maxDistanceAt               DateTime?
  receiverMessagesCount       Float?
  receiverMessagesRawLast     Float?
  maxGroundSpeedKt            Float?
  maxGroundSpeedIcaoHex       String?
  maxGroundSpeedRegistration  String?
  maxGroundSpeedCallsign      String?
  maxGroundSpeedAt            DateTime?
  updatedAt                   DateTime @default(now())
  aircraft                    ReceiverDailyAircraft[]
  coverage                    ReceiverDailyCoverage[]
  coverageAltitude            ReceiverDailyCoverageAltitude[]

  @@index([maxDistanceKm])
}

model ReceiverDailyAircraft {
  date         String
  icaoHex      String
  aircraftType String?
  airline      String?
  updatedAt    DateTime @default(now())
  dailyStats   ReceiverDailyStats @relation(fields: [date], references: [date], onDelete: Cascade)

  @@id([date, icaoHex])
}

model ReceiverDailyCoverage {
  date          String
  azimuthBucket Int
  maxDistanceKm Float
  updatedAt     DateTime @default(now())
  dailyStats    ReceiverDailyStats @relation(fields: [date], references: [date], onDelete: Cascade)

  @@id([date, azimuthBucket])
}

model ReceiverDailyCoverageAltitude {
  date          String
  azimuthBucket Int
  altitudeBand  Int
  maxDistanceKm Float
  updatedAt     DateTime @default(now())
  dailyStats    ReceiverDailyStats @relation(fields: [date], references: [date], onDelete: Cascade)

  @@id([date, azimuthBucket, altitudeBand])
}

model Flight {
  id         Int              @id @default(autoincrement())
  instanceKey String          @unique
  aircraftId Int
  callsign   String?
  registration String?
  aircraftType String?
  airline String?
  origin String?
  destination String?
  maxAltitude Int?
  minDistanceKm Float?
  startTime  DateTime         @default(now())
  lastSeenAt DateTime         @default(now())
  endTime    DateTime?
  aircraft   Aircraft         @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  positions  FlightPosition[]

  @@index([aircraftId, startTime])
  @@index([aircraftId, endTime, lastSeenAt])
  @@index([startTime, origin])
  @@index([startTime, destination])
}

model Airport {
  id                Int      @id @default(autoincrement())
  icao              String   @unique
  iata              String?
  name              String
  city              String?
  country           String?
  latitude          Float
  longitude         Float
  ourAirportsId     Int?     @unique
  ourAirportsIdent  String?  @unique
  type              String?
  elevationFt       Int?
  scheduledService  Boolean?
  region            String?
  localCode         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  runways           AirportRunway[]
  frequencies       AirportFrequency[]
  associatedNavaids Navaid[]

  @@index([iata])
  @@index([country])
  @@index([ourAirportsIdent])
}

model AirportRunway {
  id                     Int      @id
  airportId              Int
  sourceAirportIdent     String
  lengthFt               Int?
  widthFt                Int?
  surface                String?
  lighted                Boolean?
  closed                 Boolean?
  leIdent                String?
  leLatitude             Float?
  leLongitude            Float?
  leElevationFt          Int?
  leHeadingDegT          Float?
  leDisplacedThresholdFt Int?
  heIdent                String?
  heLatitude             Float?
  heLongitude            Float?
  heElevationFt          Int?
  heHeadingDegT          Float?
  heDisplacedThresholdFt Int?
  airport                Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
}

model AirportFrequency {
  id                 Int      @id
  airportId          Int
  sourceAirportIdent String
  type               String
  description        String?
  frequencyMhz       Float
  airport            Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
  @@index([airportId, frequencyMhz])
}

model Navaid {
  id                     Int      @id
  filename               String
  ident                  String
  name                   String
  type                   String
  frequencyKhz           Int?
  latitude               Float
  longitude              Float
  elevationFt            Int?
  country                String?
  dmeFrequencyKhz        Int?
  dmeChannel             String?
  dmeLatitude            Float?
  dmeLongitude           Float?
  dmeElevationFt         Int?
  slavedVariationDeg     Float?
  magneticVariationDeg   Float?
  usageType              String?
  power                  String?
  associatedAirportId    Int?
  associatedAirportIdent String?
  associatedAirport      Airport? @relation(fields: [associatedAirportId], references: [id], onDelete: SetNull)

  @@index([ident])
  @@index([type])
  @@index([country])
  @@index([associatedAirportId])
  @@index([latitude, longitude])
}

model AtcSector {
  id                String @id
  name              String
  polygonJson       String
  lowerAltitudeFt   Int?
  upperAltitudeFt   Int?
  lowerAltitudeReference String?
  upperAltitudeReference String?
  atcCallsign       String?
  service           String?
  primaryFrequencyMhz Float?
  alternateFrequenciesJson String?
  country           String?
  source            String
  sourceReference   String
  validFrom         DateTime?
  validTo           DateTime?
  lastVerifiedAt    DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([country])
  @@index([validFrom, validTo])
}

model AtcTransmitter {
  id           String @id
  name         String
  latitude     Float
  longitude    Float
  service      String?
  frequencyMhz Float
  notes        String?
  source       String
  sourceReference String
  validFrom    DateTime?
  validTo      DateTime?
  lastVerifiedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model FlightPosition {
  id           Int      @id @default(autoincrement())
  flightId     Int
  recordedAt   DateTime @default(now())
  lat          Float
  lon          Float
  altitude     Int?
  groundSpeed  Float?
  track        Float?
  verticalRate Int?
  flight       Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId, recordedAt])
  @@index([recordedAt])
}
